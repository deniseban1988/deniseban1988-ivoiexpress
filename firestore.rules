rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Auth & RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)fabriceallechi@gmail.com') || 
        hasRole('SUPER_ADMIN')
      );
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    function isAdminAgence() {
      return hasRole('ADMIN_AGENCE');
    }

    function isAdminHotel() {
      return hasRole('ADMIN_HOTEL');
    }

    function isVoyageur() {
      return hasRole('VOYAGEUR');
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId) || (isAdminAgence() && getUserData().agencyId == resource.data.agencyId);
      allow create: if isAuthenticated(); // New users can create their profile
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.agencyId == resource.data.agencyId &&
        request.resource.data.hotelId == resource.data.hotelId
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Reservations & Tickets
    match /reservations/{reservationId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAdminAgence() && getUserData().agencyId == resource.data.agencyId)));
      allow write: if isSuperAdmin() || (isAuthenticated() && (request.resource.data.userId == request.auth.uid || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId)));
    }

    // 3. Transport & Agencies
    match /transport_agencies/{agencyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /agencies/{agencyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /transport_trips/{tripId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId);
    }

    match /partner_registry/{id} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 4. Vehicles, Drivers & Fleet
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId);
    }

    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId);
    }

    // 5. Cameras & Vision (Supporting both camera and cameras names)
    match /cameras/{cameraId} {
      allow read: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == resource.data.agencyId);
      allow write: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId);
    }

    match /camera/{cameraId} {
      allow read: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == resource.data.agencyId);
      allow write: if isSuperAdmin() || (isAdminAgence() && getUserData().agencyId == request.resource.data.agencyId);
    }

    // 6. Hotels & Rooms
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAdminHotel() && getUserData().hotelId == hotelId);
    }

    match /hotel_rooms/{roomId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAdminHotel() && getUserData().hotelId == resource.data.hotelId);
    }

    // 7. Banners
    match /platform_banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 8. IPTV Ecosystem
    match /iptv_channels/{channelId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /iptv/{contentId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /iptv_contents/{contentId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /iptv_playlists/{playlistId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /iptv_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isAuthenticated();
    }

    match /iptv_settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /iptv_notifications/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 9. System, Governance & Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isAuthenticated();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /vip_subscriptions/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isSuperAdmin();
    }

    match /scan_validations/{id} {
      allow read: if isSuperAdmin() || isAdminAgence();
      allow write: if isAuthenticated();
    }

    match /system_health/{id} {
      allow read: if isSuperAdmin();
      allow write: if isAuthenticated(); // Governance engine writes probes
    }

    match /media_library/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /_diagnostic_tests/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isAuthenticated();
    }

    // Default: Deny all
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}

